<!DOCTYPE html
  PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en-GB">

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <title>Paisley Daily Digest</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="css/main.css" />
</head>

<body>
  <div class="main-container">
    <header class="header">
      <h1 class="header__title">
        Paisley <%= data.name %>
      </h1>
      <div class="header__date">
        <div class="header__date__day-of-the-month">
          <%= data.date.date%>
        </div>
        <div class="header__date__day-of-the-week">
          <%= data.date.weekDay%>
        </div>
        <div class="header__date-month">
          <%= data.date.month%>, <%= data.date.year%>
        </div>
      </div>
    </header>

    <main class="content">
      <%data.mails.forEach(entry=> {%>
        <section class="mail-entry">
          <% if(entry.sections) {%> 
            <%- include('partials/posts-with-chunk-sections.ejs', { 
              name: data.name, 
              sections: entry.sections 
                }) %>
              <%} else {%> 
                <%- include('partials/posts-section.ejs', { 
                  config: entry.config, 
                  posts: entry.posts 
                }) %>
              <%}%>
        </section>
        <% }) %>
    </main>
    <footer class="footer-section">
      <p class="footer-section__brand-name">
        Automatically Generated with love By
        <span class="orange">Paisley Digest</span>
      </p>
    </footer>
  </div>
</body>
</html>